#!/bin/sh /etc/rc.common
# procd init for tunnelkit on OpenWrt. respawn = procd brings it back if it dies.
USE_PROCD=1
START=95
STOP=10

start_service() {
	config_load tunnelkit
	local host port user key forwards saint sacnt statsfwd stfwd impl sshcmd
	config_get host     main host
	config_get port     main ssh_port 2222
	config_get user     main username tunnel
	config_get key      main key_file /etc/tunnelkit/id_tunnel
	config_get forwards main remote_forwarding
	config_get saint    main server_alive_interval 20
	config_get sacnt    main server_alive_count_max 3
	config_get statsfwd main stats_forward_port 0
	config_get stfwd    main speedtest_forward_port 0
	# ssh_impl: 'dropbear' (default, ships in the OpenWrt base) or 'openssh'
	# (requires the openssh-client package; larger channel window -> much better
	# throughput through the tunnel on high-latency links). ssh_command: the binary
	# to use; defaults to dbclient/ssh depending on the impl.
	config_get impl     main ssh_impl dropbear
	if [ "$impl" = "openssh" ]; then
		config_get sshcmd main ssh_command ssh
	else
		config_get sshcmd main ssh_command dbclient
	fi

	[ -z "$host" ] && { echo "tunnelkit: missing 'host' in /etc/config/tunnelkit"; return 1; }

	procd_open_instance
	procd_set_param command /usr/bin/tunnelkit-client \
		--host "$host" --ssh-port "$port" --user "$user" --key "$key" \
		--forwards "$forwards" --alive-interval "$saint" \
		--alive-count "$sacnt" --stats-forward "$statsfwd" \
		--speedtest-forward "$stfwd" --ssh-impl "$impl" --ssh-command "$sshcmd"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "tunnelkit"
}
