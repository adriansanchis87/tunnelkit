config tunnelkit 'main'
	option host ''
	option ssh_port '2222'
	option username 'tunnel'
	option key_file '/etc/tunnelkit/id_tunnel'
	option remote_forwarding '8050:localhost:8123'
	option server_alive_interval '20'
	option server_alive_count_max '3'
	option stats_forward_port '0'
	option speedtest_forward_port '0'
	# 'dropbear' (default) or 'openssh' (needs openssh-client; much better
	# throughput through the tunnel on high-latency links). With openssh the key
	# (key_file) must be in OpenSSH format.
	option ssh_impl 'dropbear'
	#option ssh_command 'ssh'
